NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://example.com/jynx/use-a-long-random-path
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_CERTIFICATE_PATH=
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8081
JYNX_OWNER_ID=
JYNX_ADMIN_IDS=
JYNX_APPROVAL_CHAT_ID=
JYNX_ERROR_CHAT_ID=
# Optional Telegram custom emoji IDs. The bot owner's Premium must be active.
JYNX_CUSTOM_EMOJI_IDS=

# Model provider (internal only - never surfaced to users)
MAGICA_API_KEY=
MAGICA_BASE_URL=
MAGICA_MODEL=claude_opus_4_8
MAGICA_API_STYLE=openai

# Database
DATABASE_URL=postgresql://jynx:jynx@localhost:5432/jynx

# Logging
LOG_LEVEL=info
LOG_PRIVATE_MESSAGES=false
LOG_MODEL_PROMPTS=false
LOG_TOOL_OUTPUTS=false

# Conversation / context limits
MAX_HISTORY_MESSAGES=40
MAX_GROUP_CONTEXT_MESSAGES=80
MAX_RESPONSE_CHARS=12000

# Agent runtime limits
MAX_AGENT_STEPS=15
MAX_ACTIVE_RUNS_PER_USER=2
MAX_CONCURRENT_AGENT_RUNS=1
MAX_CONCURRENT_MODEL_REQUESTS=4
MAX_MODEL_REQUESTS_PER_USER_PER_MINUTE=20
MAX_PROPOSALS_PER_USER_PER_HOUR=10
MESSAGE_BURST_COALESCE_MS=1200
ENABLE_MESSAGE_REACTIONS=true
MODEL_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=2

# Group participation
DEFAULT_GROUP_PARTICIPATION=balanced
PROACTIVE_REPLY_COOLDOWN_SECONDS=180
PROACTIVE_REPLIES_PER_HOUR=4

# High-risk features (default disabled)
ENABLE_SELF_MODIFICATION=false
ENABLE_AUTOMATIC_RESTART=false

# GitHub (agent PR pipeline) - fine-grained PAT scoped to one repo:
# Contents read/write, Pull requests read/write, Metadata read-only
GITHUB_TOKEN=
GITHUB_REPO=nicetrykiddo/jynx.js
GITHUB_DEFAULT_BRANCH=main

# Agent executor
AGENT_WORKDIR=.jynx-work
AGENT_COMMAND_TIMEOUT_MS=300000
AGENT_ALLOWED_COMMANDS=git,npm

# Deployment timezone (IANA name, e.g. Asia/Kolkata, America/New_York)
JYNX_TIMEZONE=UTC

# Web search (fact-check) - Tavily-compatible API
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=5

# Owner-only self-inspection (db/file/source), restricted to owner DMs + approval + logging chats
ENABLE_OWNER_INTROSPECTION=true
INTROSPECTION_ROOT=.
